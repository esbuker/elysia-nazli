{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "bench/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
