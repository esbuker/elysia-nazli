{
  "name": "elysia-nazli",
  "version": "2.0.0",
  "description": "Production-friendly, store-pluggable rate limiting plugin for Elysia on Bun.",
  "license": "MIT",
  "author": "Enes Büker (https://github.com/esbuker)",
  "homepage": "https://github.com/esbuker/elysia-nazli#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/esbuker/elysia-nazli.git"
  },
  "bugs": {
    "url": "https://github.com/esbuker/elysia-nazli/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "default": "./dist/redis.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "elysia",
    "bun",
    "rate-limit",
    "rate-limiter",
    "api",
    "plugin",
    "sqlite",
    "redis"
  ],
  "peerDependencies": {
    "elysia": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.4",
    "elysia": "2.0.0-rc.0",
    "elysia-rate-limit": "5.1.1",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "scripts": {
    "typecheck": "bun check --no-script -p tsconfig.json",
    "test": "bun test tests",
    "test:integration": "bun test tests/integration",
    "bench": "bun run bench/benchmark.ts",
    "bench:help": "bun run bench/benchmark.ts -- --help",
    "bench:example": "bun run bench/benchmark.ts -- -m ./examples/bench.stores.example.ts",
    "bench:compare": "bun run bench/benchmark.ts -- --only-plugin-compare",
    "clean": "rm -rf dist",
    "build:js": "bun build ./src/index.ts ./src/redis.ts ./src/sqlite.ts --outdir ./dist --target bun --format esm --production --external elysia",
    "build:types": "tsc -p tsconfig.build.json",
    "size": "bun run ./scripts/sizeReport.ts",
    "build": "bun run clean && bun run build:js && bun run build:types && bun run size",
    "release:check": "bun run typecheck && bun run test && bun run build",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run format:check && bun run lint",
    "fix": "bun run format && bun run lint:fix",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json"
  }
}
